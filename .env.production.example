# Image and host binding
BABYGUESS_IMAGE_TAG=latest
BABYGUESS_HOST_PORT=8080

# H2 database credentials. Keep the password unchanged after the database is created.
BABYGUESS_DATABASE_USERNAME=sa
BABYGUESS_DATABASE_PASSWORD=

# Administrator and application secrets
BABYGUESS_ADMIN_USERNAME=admin
BABYGUESS_ADMIN_PASSWORD=
BABYGUESS_TOKEN_SECRET=
BABYGUESS_SECRET_ENCRYPTION_KEY=

# Optional Cap captcha on the submission form. Leave blank to disable it entirely.
BABYGUESS_CAPTCHA_URL=
BABYGUESS_CAPTCHA_SITE_KEY=
BABYGUESS_CAPTCHA_SECRET_KEY=

# Canonical public HTTPS URL used in participant emails
BABYGUESS_PUBLIC_BASE_URL=

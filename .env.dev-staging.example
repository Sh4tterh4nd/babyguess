# Build a local development image with:
# .\gradlew.bat jibDockerBuild -Pimage=shatterhand/babyguess:dev
BABYGUESS_IMAGE_TAG=dev
BABYGUESS_HOST_ADDRESS=0.0.0.0
BABYGUESS_HOST_PORT=8080

# The dev profile uses the safe local defaults from compose.dev-staging.yml.
SPRING_PROFILES_ACTIVE=dev

# For staging, use prod and replace every value below with a stable secret.
# Also set the public HTTPS URL, secure cookies, and usually bind to 127.0.0.1.
BABYGUESS_DATABASE_USERNAME=sa
BABYGUESS_DATABASE_PASSWORD=development-db-password
BABYGUESS_ADMIN_USERNAME=admin
BABYGUESS_ADMIN_PASSWORD=admin12345678
BABYGUESS_TOKEN_SECRET=development-only-token-secret-change-me
BABYGUESS_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BABYGUESS_PUBLIC_BASE_URL=http://localhost:8080/
BABYGUESS_SECURE_COOKIES=false
